.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  position: relative;
}

.page-bg {
  position: fixed;
  width: 100vw;
  height: 100vh;
  z-index: -1;
}
 
.nav-bar {
  position: fixed;
  top: 0;
  width: 100%;
  height: 120rpx;
  display: flex;
  align-items: center;
  z-index: 100;
}

.nav-icon {
  height: 80rpx;
  flex-shrink: 0;
}
.nav-icon.left{
  margin-left: 15rpx;
}
.nav-icon.right{
  margin-right: 15rpx;
}

.nav-title {
  color: #e5f9ff;
  font-size: clamp(32rpx, 4vw, 40rpx);
  flex: 1;
  text-align: center;
}

.main-content {
  position: relative;
  z-index: 2;
  padding-top: 140rpx; 
  padding-bottom: 200rpx; 
  flex: 1;
  display: flex;
  flex-direction: column;
}

.vehicle-image {
  position: absolute;
  left: 50%;
  transform: translate(-50%, -50%);
  top: clamp(35%, 36%, 37%);
  width: clamp(60%, 61%, 70%);
}

.button-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  position: absolute;
  width: 100%;
  top: 62%;
}

.button-row {
  display: flex;
  justify-content: space-around;
}

.button-item {
  position: relative;
  width: clamp(100rpx, 20vw, 140rpx);
  height: clamp(120rpx, 24vw, 160rpx);
  user-select: none;
  display: flex;
  justify-content: center;
  align-items: center;
}

.button-icon {
  width: 100%;
  height: 100%;
  display: block;
}

.button-label {
  position: absolute;
  bottom: 0;
  width: 100%;
  text-align: center;
  color: white;
  font-size: 30rpx;
  padding: 4rpx 0;
  border-bottom-left-radius: 12rpx; 
  border-bottom-right-radius: 12rpx;
  user-select: none;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.start-button-container {
  position: fixed; 
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 6vh); 
  display: flex;
  justify-content: center;
  z-index: 100;
}

.start-button {
  width: clamp(240rpx, 40vw, 320rpx);
  height: auto;
}
