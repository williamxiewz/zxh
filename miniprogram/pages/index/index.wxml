<view class="container">
<!-- 背景 -->
  <view class="container-v" style="width:100%;height: 100%;">
    <image src="../../images/ctrl_top_bg.png" style="position:absolute;width:100%;height: 100%;" />
  </view>

<!-- 标题栏 -->
<view class="container-h navgation_bar" style="position: absolute;width: 100%;height: 100%;">
  <image src="{{bluetoothAvailable? '../../images/ic_bluetooth_blue.png':'../../images/ic_bluetooth_blue.png'}}" style="height:80rpx;margin-left:20rpx;" mode="heightFix"></image>
    <view style="flex:1;"></view>
    <text style="color:rgb(229, 249, 255);margin-top:10rpx; font-size: 20px;; ">比德文蓝擎系统</text>
    <view style="flex:1;"></view>
    <image src="../../images/ic_scancode.png" style="height:80rpx;margin-right:20rpx;" mode="heightFix" bindtap="scanCode"></image>
</view>

    <view class="container-r" style="width:100%;">
      <view class="container-v" style="width:100%;margin-top:200rpx;align-items: center;">
          <image class="bg_car" src="../../images/img_moto.png" style="position:absolute;" mode="widthFix" bindtap="test">
        </image>
      </view>
    </view>

    <!-- 4个按钮 -->
    <view class="container-v action_buttons" >
      <!-- 未连接设备时的4个功能按键 -->
      <view class="container-r" style="display:{{connected? 'none':'flex'}};">
        <view class="container-h bottom_bg" style="position: absolute;">
          <view class="container-r btn_lay">
            <image src="../../images/ic_lock_disabled.png" class="btn_nor" mode="heightFix" />
          </view>
          <view class="container-r btn_lay">
            <image src="../../images/ic_unlock_disabled.png" class="btn_nor" mode="heightFix" />
          </view>
          <view class="container-r btn_lay">
            <image src="../../images/{{is_kzb?'ic_kzb_disabled':'ic_call_disabled'}}.png" class="btn_nor" mode="heightFix" />
          </view>
          <view class="container-r btn_lay">
            <image src="../../images/ic_mute_disabled.png" class="btn_nor" mode="heightFix" />
          </view>
        </view>
      </view>
      <!-- 已连接设备时的4个功能按键 -->
      <view class="container-r" style="display:{{connected? 'flex':'none'}};">
        <view class="container-h bottom_bg" style="position: absolute;">
          <!-- 上锁 --> 
          <view class="container-r btn_lay">
            <image src="{{selectedBtn === 1 ? '../../images/ic_lock_pressed.png' : '../../images/ic_lock_normal.png'}}" class="btn_nor" mode="heightFix" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" data-btnindex="1" />
          </view>
          <!-- 解锁 -->
          <view class="container-r btn_lay">
            <image src="{{selectedBtn === 2 ? '../../images/ic_unlock_pressed.png' : '../../images/ic_unlock_normal.png'}}" class="btn_nor" mode="heightFix" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" data-btnindex="2" />
          </view>
          <!-- 寻车 -->
          <view class="container-r btn_lay" style="display: {{is_kzb?'none':'flex'}};">
            <image src="{{selectedBtn === 3 ? '../../images/ic_call_pressed.png' : '../../images/ic_call_normal.png'}}" class="btn_nor" mode="heightFix" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" data-btnindex="3" />
          </view>
          <!-- 开坐包 -->
          <view class="container-r btn_lay" style="display: {{is_kzb?'flex':'none'}};">
            <image src="{{selectedBtn === 3 ? '../../images/ic_kzb_pressed.png' : '../../images/ic_kzb_normal.png'}}" class="btn_nor" mode="heightFix" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" data-btnindex="3" />
          </view>
          <!-- 静音 -->
          <view class="container-r btn_lay">
            <image src="{{selectedBtn === 4 ? '../../images/ic_mute_pressed.png' : '../../images/ic_mute_normal.png'}}" class="btn_nor" mode="heightFix" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" data-btnindex="4" />
          </view>
        </view>
      </view>

      <view class="container-r" style="width: 100%;margin-top: 50rpx;">
        <view class="container-h bottom_bg" style="position: absolute;">
          <text class="btn_label" style="color: {{connected&&selectedBtn==1?'rgb(92, 229, 242)':'gray'}};">上锁</text>
          <text class="btn_label" style="color: {{connected&&selectedBtn==2?'rgb(92, 229, 242)':'gray'}};">解锁</text>
          <text class="btn_label" style="color: {{connected&&selectedBtn==3?'rgb(92, 229, 242)':'gray'}};">{{is_kzb?'开坐包':'寻车'}}</text>
          <text class="btn_label" style="color: {{connected&&selectedBtn==4?'rgb(92, 229, 242)':'gray'}};">静音</text>

        </view>
      </view>
    </view>

    <!-- 启动按钮 -->
    <view class="container-r action_start">

          <image src="../../images/btn_start_disabled.png"  style="display:{{connected? 'none':'flex'}}; width: 320rpx;height: 320rpx;" mode="widthFix" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" data-btnindex="0" />


          <image src="{{connected && selectedBtn === 0 ? '../../images/btn_start_pressed.png':'../../images/btn_start_normal.png'}}"  style="display:{{connected? 'flex':'none'}}; width: 320rpx;height: 320rpx;" mode="widthFix" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" data-btnindex="0" />


        
    </view>

  </view>
