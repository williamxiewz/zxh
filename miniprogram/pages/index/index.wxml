<!-- 整体容器 -->
<view class="page-container">
  <!-- 背景层 -->
  <image class="page-bg" src="../../images/ctrl_top_bg.png" mode="aspectFill" />

  <!-- 标题栏 (固定定位) -->
  <view class="nav-bar"  style="margin-top:{{navBarHeight}}px;">
    <image class="nav-icon left" src="{{bluetoothAvailable ? '../../images/ic_bluetooth_blue.png' : '../../images/ic_bluetooth_blue.png'}}" mode="heightFix" />
    <text class="nav-title">比德文蓝擎系统</text>
    <image class="nav-icon right" src="../../images/ic_scancode.png" mode="heightFix" bindtap="scanCode" />
  </view>

  <!-- 主体内容 (弹性布局) -->
  <view class="main-content" >
    <!-- 车辆图片 -->
    <image  
    class="vehicle-image" 
     src="../../images/img_moto.png"  
     mode="widthFix" 
     />

    <!-- 功能按钮区 -->
    <view class="button-group">
      <!-- 按钮容器 -->
      <view class="button-row {{connected ? 'active' : 'disabled'}}" >
        <block wx:for="{{buttonConfig}}" wx:key="index">
          <view 
            class="button-item"
            bindtouchstart="onTouchStart" 
            bindtouchend="onTouchEnd"
            data-btnindex="{{item.index}}"
          >
            <image 
              class="button-icon"
              src="{{connected ? (selectedBtn === item.index ? item.activeIcon : item.normalIcon) : item.disabledIcon}}"
              mode="heightFix" 
            />
            <!-- style="color: {{connected && selectedBtn === item.index ? 'rgb(92, 229, 242)' : 'gray'}};  -->
            <text 
            class="button-label"
            
            style="color: {{connected? (connected&& selectedBtn === item.index ? 'rgb(92, 229, 242)' : 'rgb(123, 154, 151)'):'gray'}}; " >
            {{item.label}}
          </text>
          </view>
        </block>
      </view>

   
    </view>

    <!-- 启动按钮 -->
    <view class="start-button-container">
      <image 
        class="start-button"
        src="{{connected ? (selectedBtn === 0 ? '../../images/btn_start_pressed.png' : '../../images/btn_start_normal.png') : '../../images/btn_start_disabled.png'}}"
        mode="widthFix" 
        bindtouchstart="onTouchStart" 
        bindtouchend="onTouchEnd"
        data-btnindex="0"
      />
    </view>
  </view>
</view>